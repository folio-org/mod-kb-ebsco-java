{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Package Subject Schema",
  "description": "Managed or custom subject associated with a package",
  "javaType": "org.folio.rest.jaxrs.model.PackageSubject",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "Subject id",
      "example": 26224,
      "type": "integer"
    },
    "name": {
      "description": "Subject name",
      "example": "Science",
      "type": "string"
    },
    "isCustom": {
      "description": "Whether this subject is custom or managed",
      "example": false,
      "type": "boolean"
    }
  }
}
