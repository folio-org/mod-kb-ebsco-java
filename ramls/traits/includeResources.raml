queryParameters:
  include:
    displayName: Related Resources
    type: string
    description: |
      Comma-separated list of what to include:
      `resources` - related resource objects, each representing a partnering of this title with a package;
      `relationships` - title relationships (single title only).
      Any bogus value, like `include=deciduousTrees`, will be silently ignored.
    example: resources
    required: false
