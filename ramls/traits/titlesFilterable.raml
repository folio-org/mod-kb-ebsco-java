queryParameters:
  filter[selected]:
    displayName: Selection status
    type: string
    description: Filter to narrow down results based on selection status. Defaults to all. Possible values are all, true, false, ebsco.
    example: ebsco
    required: false
  filter[type]:
    displayName: Resource type
    type: string
    description: | 
       Filter to narrow down results based on content type. 
       Possible values are all, audiobook, book, bookseries, database, journal, newsletter, newspaper, proceedings, report, streamingaudio, streamingvideo,thesisdissertation, website, unspecified.
    required: false
  filter[access]:
    displayName: Package access
    type: string
    description: |
      Limits the results based on Package Free Access.
      Possible values: public, controlled
    example: public
    required: false
  filter[packageIds]:
    displayName: Query by package Ids
    type: string[]
    description: Search by package ids.
    required: false
